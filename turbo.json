{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "tags": ["ci"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "public/ocr/**"
      ]
    },
    "lint": {
      "tags": ["ci"],
      "outputs": []
    },
    "typecheck": {
      "tags": ["ci"],
      "dependsOn": ["build"],
      "outputs": []
    }
  }
}
